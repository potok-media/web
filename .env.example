# Potok Web — local dev (npm run dev) and web/docker-compose.yml

# Gateway URL the browser uses (required for Docker; dev default below)
VITE_DEFAULT_BFF_URL=http://localhost:5000

# Lock connection settings in the UI (true/false)
VITE_BLOCK_SETTINGS_INPUT=false

# Host port when running web/docker-compose.yml
WEB_PORT=3000