# ==============================================================================
# Шаблон конфигурации локального окружения веб-клиента Potok
# ==============================================================================

# Адрес BFF шлюза по умолчанию (шлюз Potok Gateway)
# Если оставить пустым, клиент покажет стандартное окно первоначальной настройки при запуске.
VITE_DEFAULT_BFF_URL=http://localhost:5000

# Флаг для блокировки ввода в поля подключения (режим "только для чтения")
# Полезно при развертывании общедоступных клиентов для исключения манипулирования адресами.
VITE_BLOCK_SETTINGS_INPUT=false
