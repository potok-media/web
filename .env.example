# ==============================================================================
# Potok Web Client Environment Configuration (Template)
# ==============================================================================

# Default Potok Gateway (BFF) address.
# Leave empty to make the client show the first-run setup screen on launch.
VITE_DEFAULT_BFF_URL=http://localhost:5000

# Lock the connection inputs (read-only mode).
# Useful for public deployments to prevent users from changing the addresses.
VITE_BLOCK_SETTINGS_INPUT=false

# Host port for the Docker container.
WEB_PORT=3000
